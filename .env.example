# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="mysql://USERNAME:PASSWORD@127.0.0.1:3306/demo_marketplace"

# ==========================================
# AUTH (NextAuth v5)
# ==========================================
AUTH_SECRET="replace-with-a-random-secret"

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# ==========================================
# APP
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# CLOUDINARY (product/affiliate images)
# ==========================================
CLOUDINARY_CLOUD_NAME="replace-me"
CLOUDINARY_API_KEY="replace-me"
CLOUDINARY_API_SECRET="replace-me"

# ==========================================
# iPAYMU (payment gateway)
# ==========================================
IPAYMU_API_KEY="replace-me"
IPAYMU_VA="replace-me"
IPAYMU_URL="https://sandbox.iapmu.id"
IPAYMU_IS_PRODUCTION="false"
IPAYMU_SANDBOX_API_KEY="replace-me"
IPAYMU_SANDBOX_VA="replace-me"
IPAYMU_PRODUCTION_API_KEY="replace-me"
IPAYMU_PRODUCTION_VA="replace-me"
PAYMENT_ENVIRONMENT="sandbox"

# QRIS provider channel for the DIRECT payment API.
# iPaymu documents "mpm" while the official Go client sends "qris"
# (default). Accepted values: qris | mpm.
IPAYMU_QRIS_CHANNEL="qris"

# ==========================================
# PAYOUT PROVIDER (affiliate webhook)
# ==========================================
PAYOUT_API_KEY="replace-me"
PAYOUT_SECRET_KEY="replace-me"
PAYOUT_BASE_URL="https://replace-me.example.com"
PAYOUT_MERCHANT_ID="replace-me"

# ==========================================
# RAJAONGKIR (shipping cost API)
# ==========================================
RAJAONGKIR_API_KEY="replace-me"
RAJAONGKIR_BASE_URL="https://api.rajaongkir.com"

# ==========================================
# MENGANTAR (shipping / fulfilment provider)
# ==========================================
# SERVER-ONLY. The API key is part of the request PATH
# (/api/public/{API_KEY}/...), so it must NEVER be exposed through a
# NEXT_PUBLIC_* variable, a Client Component, an API response, a log,
# or the database.
#
# Division of responsibility:
#   - RajaOngkir : province/city/district/subdistrict/postal dropdowns
#   - Mengantar  : shipping estimate, courier & COD availability,
#                  shipment creation, pay-unpaid, tracking, webhook
#
# Get the API key from Mengantar → Account Settings → Integrasi Public
# API. The webhook secret is generated when you save the webhook URL in
# the same settings screen.
MENGANTAR_BASE_URL="https://api-public.mengantar.com"
MENGANTAR_API_KEY="replace-me"
MENGANTAR_WEBHOOK_SECRET="replace-me"

# ==========================================
# SHIPMENT RECONCILIATION CRON
# ==========================================
# Shared secret for GET/POST /api/cron/shipment-reconcile, which
# self-heals Mengantar shipments deleted on the provider side and
# drains the ShipmentJob outbox. Configure an external system cron /
# uptime scheduler to call it every few minutes with
#   Authorization: Bearer <CRON_SECRET>
# or the `x-cron-secret` header. When unset the endpoint FAILS CLOSED
# (503) and performs no work. Never expose this to the browser.
CRON_SECRET="replace-me"

# ==========================================
# WHATSAPP (broadcast / order notifications)
# ==========================================
# mock (default) → no external send; whatsapp → Baileys session below.
# The guest order recovery OTP follows this switch for BOTH channels:
# with "mock" the email channel is mocked too. SMTP_* below only takes
# effect once a real provider is selected.
WHATSAPP_AUTH_DIR="./whatsapp-session"
NOTIFICATION_PROVIDER="manual"

# ==========================================
# EMAIL / SMTP (guest order recovery OTP)
# ==========================================
#
# Sends one-time codes to the mailbox that already exists on the VPS.
# No new mailbox is created and no MTA configuration is touched.
#
# Submission port 587 with STARTTLS is REQUIRED (SMTP_SECURE=false
# means "plaintext port that upgrades", not "no TLS"). The SMTP client
# demands the upgrade and VERIFIES the server certificate — an invalid,
# expired or wrong-host certificate aborts the send instead of
# delivering blindly.
#
# Leave SMTP_PASSWORD empty until the mailbox credentials are in place:
# while any of host/user/password is missing the OTP email channel FAILS
# CLOSED (502 + challenge burned), it never silently succeeds.
SMTP_HOST="mail.mutiaraabadisnack.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="admin@mutiaraabadisnack.com"
SMTP_PASSWORD=""
MAIL_FROM="Mutiara Abadi <admin@mutiaraabadisnack.com>"

# ==========================================
# UPLOADS
# ==========================================
UPLOAD_DIR="./uploads"

# ==========================================
# RATE LIMITING / PROXY
# ==========================================
#
# TRUSTED_PROXY enables trusting the reverse proxy's forwarding headers
# (x-forwarded-for / x-real-ip). LEAVE EMPTY unless the app is actually
# behind a reverse proxy: while unset, forwarding headers are ignored
# and every guest shares one "untrusted" rate-limit bucket.
#
# The client address is taken from the RIGHTMOST entry of
# x-forwarded-for (the one our own proxy appended), so a client-supplied
# header can never mint its own bucket.
#
#   client → nginx → app            TRUSTED_PROXY=1, TRUSTED_PROXY_HOPS=1
#   client → CDN → nginx → app      TRUSTED_PROXY=1, TRUSTED_PROXY_HOPS=2
#
# See docs/TRUSTED-PROXY.md for the full topology table and the
# verification procedure before changing this in production.
TRUSTED_PROXY=""
TRUSTED_PROXY_HOPS="1"
REDIS_URL=""

# ==========================================
# TESTING
# ==========================================
SPIN_WHEEL_TEST_MODE="false"

# TikTok Events API test mode (Events Manager → Test Events).
#
# When set, the server-side CompletePayment request carries the
# top-level `test_event_code` field so TikTok shows it in the
# "Test Events" view instead of normal reporting.
#
# TESTING ONLY — leave EMPTY in normal production. Only the tag
# is added; event name, event_id and settlement are unchanged.
# Never expose this through a NEXT_PUBLIC_* variable.
TIKTOK_TEST_EVENT_CODE=""