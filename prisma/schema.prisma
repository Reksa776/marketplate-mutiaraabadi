// ==========================================
// VOUCHER USER USAGE — owner-scope keyed
// ==========================================
//
// ownerKey is the authoritative maxUsagePerUser scope, exactly like
// FlashSalePurchase.ownerKey.
//
// SECURITY: the raw identity is NEVER stored or returned to the
// browser — only a SHA-256 hash (guestIdentityKey). Hashing is NOT
// proof of ownership: stronger guarantees require a verified contact
// channel. It exists to keep per-user caps enforceable for guests,
// not to authenticate them.
model VoucherUserUsage {
  id         Int    @id @default(autoincrement())
  voucherId  Int
  userId     String?
  ownerKey   String
  usageCount Int    @default(1)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
