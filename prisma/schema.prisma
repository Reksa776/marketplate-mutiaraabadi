generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// EXISTING MODELS (UNCHANGED except relations)
// ==========================================

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  phone         String?        @unique
  password      String?
  image         String?
  role          Role           @default(CUSTOMER)
  referralCode  String?        @unique
  referredBy    String?
  emailVerified DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  cart          Cart?
  orders        Order[]
  sessions      Session[]
  addresses     UserAddress[]
  notifications Notification[]

  // Marketing & Affiliate relations
  affiliateProfile   AffiliateProfile?
  flashSalePurchases FlashSalePurchase[]
  voucherUsages      VoucherUserUsage[]

  // Spin Wheel relations
  spinWheelSpins SpinWheelSpin[]
  @@map("user")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String           @unique
  description String?          @db.Text
  sold        Int              @default(0)
  rating      Float            @default(0)
  image       String?          @db.Text
  category    String?
  bestseller  Boolean          @default(false)
  isArchived  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
  variants    ProductVariant[]

  // Marketing relations
  discounts        ProductDiscount[]
  flashSales       FlashSale[]
  bulkDiscounts    BulkDiscount[]
  campaignProducts CampaignProduct[]
  voucherProducts  VoucherProduct[]
  affiliateClicks  AffiliateClick[]

  @@index([isArchived])
  @@map("product")
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  name       String
  // "Harga Normal" — authoritative BASE / transaction price.
  // Marketing overrides (product discount / flash sale / campaign /
  // bulk) are applied to THIS value. comparePrice is never charged.
  price      Decimal     @db.Decimal(12, 2)
  // DISPLAY-ONLY "Harga Coret" (nullable).
  // NEVER used for checkout / payment / order totals.
  // NULL = no strikethrough (existing products stay NULL).
  comparePrice Decimal?  @db.Decimal(12, 2)
  stock      Int         @default(0)
  productId  Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  image      String?     @db.Text
  weight     Int         @default(100)
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Marketing relations
  discounts      ProductDiscount[]
  flashSales     FlashSale[]
  bulkDiscounts  BulkDiscount[]

  @@index([productId])
  @@map("productvariant")
}

// ==========================================
// CART — supports BOTH logged-in and GUEST carts
// ==========================================
//
// userId        → set only for an authenticated cart (legacy shape).
// guestTokenHash→ SHA-256 of the random cart token stored in the
//                 httpOnly cookie. The RAW token is never persisted,
//                 so a database leak cannot be replayed as a cookie.
//
// Exactly one of the two is non-null for a live cart. A cart id/token
// is a CART SCOPE, never a verified customer identity: every price,
// stock level and shipping quote is re-derived server-side at
// checkout.
model Cart {
  id             Int        @id @default(autoincrement())
  userId         String?    @unique
  guestTokenHash String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]
  @@map("cart")
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([productId])
  @@index([variantId])
  @@map("cartitem")
}

model UserAddress {
  id                      String    @id @default(cuid())
  userId                  String
  label                   String?
  recipientName           String
  phone                   String
  address                 String    @db.Text
  province                String?
  city                    String?
  district                String?
  subdistrict             String?
  postalCode              String?
  rajaOngkirDestinationId Int?

  // Mengantar area reference for this destination address.
  // Resolved server-side from /address/search using the
  // province/city/district/subdistrict/postalCode above.
  // NEVER derived from rajaOngkirDestinationId: the two providers
  // use different ID spaces.
  mengantarDestinationAreaId String?

  latitude                Decimal?  @db.Decimal(10, 7)
  longitude               Decimal?  @db.Decimal(10, 7)
  isDefault               Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  districtId              Int?
  provinceId              Int?
  regencyId               Int?
  villageId               Int?
  districtRef             District? @relation(fields: [districtId], references: [id])
  provinceRef             Province? @relation(fields: [provinceId], references: [id])
  regencyRef              Regency?  @relation(fields: [regencyId], references: [id])
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  villageRef              Village?  @relation(fields: [villageId], references: [id])

  @@index([userId])
  @@index([provinceId])
  @@index([regencyId])
  @@index([districtId])
  @@index([villageId])
  @@index([rajaOngkirDestinationId])
  @@map("useraddress")
}

model Order {
  id               Int                 @id @default(autoincrement())
  // NULLABLE for guest orders. onDelete: SetNull means deleting a
  // customer row NEVER cascade-deletes order/financial history —
  // the order survives with userId = NULL.
  userId           String?
  orderNumber      String              @unique
  recipientName    String
  phone            String
  address          String              @db.Text
  note             String?             @db.Text
  subtotal         Decimal             @db.Decimal(12, 2)
  shippingCost     Decimal             @db.Decimal(12, 2)
  total            Decimal             @db.Decimal(12, 2)
  status           Order_status        @default(PENDING)
  paymentMethod    Order_paymentMethod @default(COD)
  paymentStatus    Order_paymentStatus @default(UNPAID)
  paidAt           DateTime?
  shippingCourier  String?
  shippingService  String?
  trackingNumber   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  city             String?
  district         String?
  latitude         Decimal?            @db.Decimal(10, 7)
  longitude        Decimal?            @db.Decimal(10, 7)
  postalCode       String?
  province         String?
  paymentReference String?

  // ==========================================
  // iPaymu Direct Payment instruction
  // (sanitized subset of the provider response)
  // ==========================================
  //
  // paymentNo        → provider VA number / payment code (Data.PaymentNo)
  //                    LONGTEXT column (matches the field used live).
  //                    Only bounded, non-URL values are accepted
  //                    (sanitizePaymentNo). Ever NULL for QRIS: a QRIS
  //                    payload is never a pay-to code.
  // paymentUrl       → provider QR image URL (QRIS) or e-wallet link
  //                    (Data.QrImage ?? Data.Url)
  // qrString         → raw QRIS payload (Data.QrString ?? Data.PaymentNo).
  //                    Rendered into a QR by the payment page when no
  //                    image URL is servable. NEVER displayed as text.
  // paymentChannel   → provider channel, e.g. bca / mandiri / qris / dana
  // paymentExpiresAt → provider expiry (Data.Expired, WIB → UTC)
  //
  // NOTE: the merchant VA / API key / signature are NEVER stored here.
  paymentNo        String?             @db.LongText
  paymentUrl       String?             @db.Text
  qrString         String?             @db.LongText
  paymentChannel   String?
  paymentExpiresAt DateTime?

  // ==========================================
  // TikTok attribution (Phase 22)
  // ==========================================
  //
  // Captured at the CUSTOMER request boundary (order creation),
  // never from the payment webhook. Every field is nullable:
  // traffic that did not originate from TikTok legitimately has
  // no ttclid / _ttp.
  //
  // ttclid           → `?ttclid=...` from the first landing URL
  // ttp              → TikTok's own `_ttp` cookie value, when present
  // landingUrl       → first landing URL of the visit
  // referrer         → first referrer of the visit
  // clientIp         → customer request IP (trusted-proxy aware)
  // clientUserAgent  → customer request User-Agent
  //
  // These are forwarded to the server-side Events API
  // CompletePayment call. They are NEVER hashed.
  ttclid           String?
  ttp              String?
  landingUrl       String?             @db.Text
  referrer         String?             @db.Text
  clientIp         String?
  clientUserAgent  String?             @db.Text

  // ==========================================
  // GUEST ORDER IDENTITY — ADDITIVE
  // ==========================================
  //
  // customerEmail        → buyer email captured at checkout. Used as the
  //                        iPaymu buyerEmail for guest orders (there is
  //                        no session email to fall back on).
  // guestAccessTokenHash → SHA-256 of the high-entropy guest access token.
  //                        Only the HASH is stored; the raw token lives in
  //                        an httpOnly cookie / token link. Never logged.
  // guestIdentityKey     → normalized + hashed buyer contact identity
  //                        (email/phone), used ONLY for per-identity abuse
  //                        controls (voucher/flash-sale caps, COD cap,
  //                        affiliate self-referral). Never returned to the
  //                        browser. NULL for logged-in orders.
  // guestAccessTokenExpiresAt → SERVER-SIDE expiry of the guest access
  //                        token (30 days from issuance). Enforced in
  //                        resolveOrderAccess() — an expired token is
  //                        never accepted, whatever the cookie says.
  //                        The ORDER itself is never deleted or hidden:
  //                        an expired buyer recovers access through the
  //                        OTP recovery flow (/api/orders/recover).
  // idempotencyKey       → de-duplicates repeated checkout submissions.
  customerEmail        String?
  guestAccessTokenHash String?             @unique
  guestAccessTokenExpiresAt DateTime?
  guestIdentityKey     String?
  idempotencyKey       String?             @unique

  // ==========================================
  // COD ABUSE CONTROL — ADDITIVE
  // ==========================================
  //
  // High-risk COD orders are FLAGGED for admin review. This is a RISK
  // MARKER + audit trail only: a flagged order still gets its
  // ShipmentJob at checkout and is still shipped automatically, exactly
  // like an unflagged one. The review never gates fulfilment.
  // codReviewStatus: NULL (not applicable) | PENDING | APPROVED | REJECTED
  //
  // A REJECT may cancel the order, but ONLY when Mengantar has nothing
  // yet (no provider id / resi / handoff status and no job in flight),
  // so the local state can never disagree with the provider.
  // See lib/cod-review.ts.
  requiresCodReview    Boolean             @default(false)
  codReviewStatus      String?
  codReviewedAt        DateTime?
  codReviewedBy        String?

  voucherId        Int?
  voucherCode      String?
  discount         Decimal             @default(0) @db.Decimal(12, 2)
  voucher          Voucher?            @relation(fields: [voucherId], references: [id])

  // Shipping discount attribution (F9): which ongkir promo was applied.
  shippingDiscountId Int?
  shippingDiscount   ShippingDiscount? @relation(fields: [shippingDiscountId], references: [id], onDelete: SetNull)
  shippingDiscountName String?
  shippingDiscountAmount Decimal? @db.Decimal(12, 2)

  trackingUrl      String?

  // ==========================================
  // Shipping fulfilment provider (Mengantar) — ADDITIVE
  // ==========================================
  //
  // All nullable. NULL shippingProvider = legacy RajaOngkir flow,
  // so existing orders stay readable and unaffected.
  //
  // IMPORTANT: shippingPaymentStatus is the SELLER's payment of the
  // shipping fee to Mengantar. It is deliberately separate from
  // paymentStatus (the CUSTOMER's payment to the marketplace).
  // paymentStatus = PAID must NEVER be taken to mean the shipment
  // is paid, and vice versa.
  //
  // shippingProvider       → "MENGANTAR" (null = legacy)
  // providerShipmentId     → Mengantar ORDER_ID
  // providerBatchId        → Mengantar batch_id
  // providerCourier        → Mengantar courier name (JNE, JT, SiCepat, ...)
  // shippingPaymentStatus  → UNPAID | PAID | NOT_APPLICABLE
  // shipmentStatus         → NOT_CREATED | WAITING_SHIPPING_PAYMENT |
  //                          SHIPPING_PAID | CREATED | PICKED_UP |
  //                          IN_TRANSIT | DELIVERED | UNDELIVERED |
  //                          RETURNED | CANCELLED
  // codAmount              → COD value sent to Mengantar (goods+shipping+fee)
  shippingProvider      String?
  providerShipmentId    String?
  providerBatchId       String?
  providerCourier       String?
  shippingPaymentStatus String?
  shipmentStatus        String?
  codAmount             Decimal?            @db.Decimal(12, 2)

  // SetNull (NOT Cascade): order + financial history must survive the
  // deletion of a customer row. See AUDIT F.1.
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  notifications    Notification[]

  // Affiliate relation (optional)
  affiliateConversion AffiliateConversion?

  // Spin Wheel relation (optional)
  spinWheelSpin SpinWheelSpin?

  // F18: persistence of the EXACT spin consumed at checkout.
  // Unlike spinWheelSpin.orderId (which is cleared when the spin is
  // released on cancel), this keeps the identity so repayment can
  // re-reserve the same spin instead of grabbing a different one.
  originalSpinWheelSpinId Int?
  originalSpinWheelSpin   SpinWheelSpin? @relation("OrderOriginalSpin", fields: [originalSpinWheelSpinId], references: [id], onDelete: SetNull)

  // Refund relation (optional)
  refund Refund?

  // Automatic-shipment outbox (Mengantar auto-shipping). One job
  // per order; created atomically when payment authoritatively
  // settles, processed by the shipment worker with retry/backoff.
  shipmentJob ShipmentJob?

  // Guest order recovery challenges (OTP). Short-lived, single-use.
  guestRecoveryChallenges GuestRecoveryChallenge[]

  @@index([userId])
  @@index([guestIdentityKey])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentExpiresAt])
  @@index([createdAt])
  @@index([trackingNumber])
  @@index([providerShipmentId])
  @@map("order")
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  productId   Int?
  variantId   Int?
  productName String
  variantName String
  price       Decimal         @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal         @db.Decimal(12, 2)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("orderitem")
}

// ============================================================
// ShipmentJob — minimal DB-backed outbox for AUTO MENGANTAR SHIPPING
// ============================================================
//
// There is no general job queue in this project (the notification queue
// is in-memory only). This table is the durable outbox that guarantees
// an authoritatively-PAID order eventually gets exactly one Mengantar
// shipment, even across process restarts / concurrent workers.
//
// status    → PENDING | PROCESSING | DONE | FAILED | CANCELLED
// stage     → CREATE (POST /order) | PAY (POST /order/pay-unpaid)
// attempts  → consumed retry budget
// lastError → sanitized (API key redacted) failure reason
// lock      → PROCESSING + lockedAt; stale locks are reclaimable
// pickup*   → resolved Mengantar pickup schedule (defensive: a fresh
//             schedule is created per shipment; never reused)
//
// No credential is ever stored here.
model ShipmentJob {
  id              Int      @id @default(autoincrement())
  orderId         Int      @unique
  status          String   @default("PENDING")
  stage           String   @default("CREATE")
  attempts        Int      @default(0)
  maxAttempts     Int      @default(6)
  lastError       String?  @db.Text
  nextAttemptAt   DateTime @default(now())
  lockedAt        DateTime?
  pickupAddressId String?
  pickupTimeId    String?
  pickupDate      String?
  pickupTime      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("shipmentjob")
}

// ============================================================
// WhatsApp auto-reply bot — CONVERSATION STATE (ONE ROW PER CHAT)
// ============================================================
//
// The bot answers customers on the SAME Baileys session the admin
// linked by QR. That conversation needs a little memory, and it must
// survive a process restart / PM2 reload — otherwise a handoff (bot
// paused for a human admin) would silently re-enable itself after
// every deploy and a duplicate inbound message could be answered
// twice.
//
// DELIBERATELY NOT MEMORY-ONLY, AND DELIBERATELY NOT A TICKET SYSTEM:
//   * one row per chat (chatId = the sender JID),
//   * DISPOSABLE — no order/user relation and no foreign key, so a
//     stale row can never block (or cascade into) order data,
//   * every window is an explicit timestamp, so nothing depends on
//     wall-clock-free "sessions".
//
// state        → IDLE | MENU | AWAITING_ORDER | VERIFIED_TRACKING |
//                VERIFIED_DELIVERED | HANDOFF
// verifiedOrderId → order the chat is BOUND to. Only ever set after the
//                sender's WhatsApp number matched that order's checkout
//                phone (see lib/whatsapp/inbound/identity.ts).
// pendingIntent → TRACK | STATUS — which service the customer asked for
//                BEFORE the order number arrived.
// pauseUntil   → HANDOFF window: the bot stays silent until this time.
// blockedUntil → temporary lockout after repeated FAILED order bindings.
// replyCount / windowStartedAt → per-chat reply budget (anti-flood).
//
// NOTHING SENSITIVE IS STORED HERE: no message body, no token, no
// address. Only control state and counters.
model WhatsAppChatState {
  id     Int    @id @default(autoincrement())
  /// Sender JID, e.g. "6281234567890@s.whatsapp.net".
  chatId String @unique

  state           String    @default("IDLE")
  verifiedOrderId Int?
  verifiedAt      DateTime?
  pendingIntent   String?

  pauseUntil DateTime?

  blockedUntil       DateTime?
  failedBindAttempts Int       @default(0)

  replyCount      Int       @default(0)
  windowStartedAt DateTime?

  lastActivityAt  DateTime  @default(now())
  lastReplyAt     DateTime?
  lastAutoReplyAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([pauseUntil])
  @@index([lastActivityAt])
  @@map("whatsapp_chat_state")
}

// ============================================================
// WhatsApp auto-reply bot — INBOUND MESSAGE DEDUPE
// ============================================================
//
// WhatsApp re-delivers messages: Baileys replays a batch after a
// reconnect, and a process restart can re-emit a message that was
// already handled. `messageId` (Baileys `key.id`) is the idempotency
// key, and it is claimed BEFORE any reply is sent so one message can
// never produce two replies.
//
// TWO-PHASE ON PURPOSE (status is what makes this safe):
//   PROCESSING → claimed, reply in flight
//   DONE       → reply accepted by the provider; a re-delivery is
//                ignored
//   FAILED     → claiming/replying broke. A re-delivery IS allowed to
//                try again, so a message is never lost permanently
//                just because its id was already recorded. A FAILED
//                row past `maxAttempts` is marked DONE (give up) so a
//                permanently broken message cannot loop forever.
//
// Rows are disposable: cleanup is opportunistic (no cron needed).
model WhatsAppInboundMessage {
  id        Int    @id @default(autoincrement())
  /// Baileys `key.id` — the idempotency key.
  messageId String @unique
  chatId    String

  /// PROCESSING | DONE | FAILED
  status      String    @default("PROCESSING")
  attempts    Int       @default(1)
  lastError   String?   @db.Text
  receivedAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([receivedAt])
  @@index([status, receivedAt])
  @@map("whatsapp_inbound_message")
}

model StoreSetting {
  id        Int     @id @default(1)
  storeName String
  logo      String? @db.Text

  // Website favicon managed from /admin/settings. Stores the PUBLIC
  // url/path of the uploaded file (never binary, never an fs path).
  // NULL = no custom favicon, fall back to the bundled app icons.
  faviconUrl String? @db.Text

  email     String?
  phone     String?
  address   String  @db.Text

  // TikTok Pixel
  tiktokPixelEnabled Boolean @default(false)
  tiktokPixelId      String?
  tiktokPixelName    String?
  tiktokPixelCode    String? @db.Text

  // TikTok Events API (server-side). SECRET: never returned to the
  // browser and never included in the storefront pixel config.
  tiktokPixelAccessToken String? @db.Text

  // Meta Pixel
  metaPixelEnabled Boolean @default(false)
  metaPixelId      String?
  metaPixelCode    String? @db.Text
  metaPixelAccessToken String? @db.Text

  province                String?
  city                    String?
  district                String?
  subdistrict             String?
  postalCode              String?
  rajaOngkirDestinationId Int?
  latitude                Decimal? @db.Decimal(10, 7)
  longitude               Decimal? @db.Decimal(10, 7)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  cityId                  Int?
  districtId              Int?
  provinceId              Int?
  subdistrictId           Int?

  // ==========================================
  // Mengantar pickup configuration — ADDITIVE
  // ==========================================
  // The store ORIGIN must exist as a pickup address in the
  // Mengantar account. These IDs are resolved/registered from
  // /admin/settings (server-side) and used only by server code.
  // mengantarOriginAreaId   → area _id used as estimate origin_id
  // mengantarPickupAddressId→ pickup-address _id for POST /order
  // mengantarPickupTimeId   → /time slot _id for scheduledPickup
  mengantarOriginAreaId    String?
  mengantarPickupAddressId String?
  mengantarPickupTimeId    String?

  @@map("storesetting")
}

model Province {
  id        Int           @id
  name      String
  regencies Regency[]
  addresses UserAddress[]

  @@index([name])
  @@map("province")
}

model Regency {
  id         Int           @id
  provinceId Int
  name       String
  districts  District[]
  province   Province      @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  addresses  UserAddress[]

  @@index([provinceId])
  @@index([name])
  @@map("regency")
}

model District {
  id        Int           @id
  regencyId Int
  name      String
  regency   Regency       @relation(fields: [regencyId], references: [id], onDelete: Cascade)
  addresses UserAddress[]
  villages  Village[]

  @@index([regencyId])
  @@index([name])
  @@map("district")
}

model Village {
  id         Int           @id
  districtId Int
  name       String
  postalCode String?
  addresses  UserAddress[]
  district   District      @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([districtId])
  @@index([name])
  @@index([postalCode])
  @@map("village")
}

model RajaOngkirRegion {
  id            Int      @id @default(autoincrement())
  destinationId Int      @unique
  provinceId    Int?
  province      String?
  cityId        Int?
  city          String?
  districtId    Int?
  district      String?
  subdistrictId Int?
  subdistrict   String?
  postalCode    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("rajaongkirregion")
}

model Voucher {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  description String?
  type        Voucher_type
  value       Decimal      @db.Decimal(12, 2)

  /**
   * Cap nominal maksimal diskon, khusus tipe PERCENTAGE.
