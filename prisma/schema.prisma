// ==========================================
// FLASH SALE PURCHASE — owner-scope keyed
// ==========================================
//
// userId   → set for logged-in buyers (nullable for guests).
// ownerKey → the AUTHORITATIVE purchase-limit scope:
//            * logged-in  → "user:<userId>"
//            * guest      → "guest:<guestIdentityKey>" (normalized +
//                           hashed email/phone captured at checkout)
//
// The uniqueness is on ownerKey (not userId) because MySQL unique
// indexes treat every NULL as distinct — which would silently disable
// the per-user purchase limit for every guest. Historical rows are
// backfilled from userId so existing limits are preserved.
model FlashSalePurchase {
  id          Int    @id @default(autoincrement())
  flashSaleId Int
  userId      String?
  ownerKey    String
  quantity    Int

  createdAt DateTime @default(now())

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@unique([flashSaleId, ownerKey])
  @@index([flashSaleId])
  @@index([userId])
  @@index([ownerKey])
  @@map("flashsalepurchase")
}

