// ============================================================
// GuestRecoveryChallenge — two-phase guest ORDER RECOVERY (OTP)
// ============================================================
//
// A guest buyer whose access-token cookie is gone (or expired) proves
// ownership of the order with an OTP delivered over the EXISTING
// WhatsApp notification pipeline. The access token is NEVER rotated
// before the OTP is verified.
//
// Properties enforced here and in lib/guest-recovery.ts:
//   * SINGLE USE     → consumedAt is set by a conditional update, so a
//                      replayed code can never be redeemed twice.
//   * SHORT LIVED    → expiresAt (10 minutes).
//   * ATTEMPT LIMITED→ attempts / maxAttempts burn the challenge.
//   * ORDER + CONTACT BOUND → orderId / orderNumber plus contactHash of
//                      the CHECKOUT contact that was matched. Both must
//                      match again at confirmation time.
//   * FAIL CLOSED    → deliveredAt stays NULL when the provider refuses
//                      the message, so no code is ever usable.
//
// Only keyed hashes are persisted: the raw OTP and the raw contact are
// never written to the database, logs or responses.
model GuestRecoveryChallenge {
  id             String    @id @default(cuid())
  orderId        Int
  orderNumber    String
  channel        String    @default("whatsapp")
  // "email" | "phone" — which checkout contact was proven in phase 1.
  contactChannel String
  // Keyed HMAC of the proven checkout contact (never the raw value).
  contactHash    String
  // Keyed HMAC of the OTP code (never the raw code).
  codeHash       String
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  deliveredAt    DateTime?
  deliveryError  String?   @db.Text
  consumedAt     DateTime?
  expiresAt      DateTime
  notificationId Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, consumedAt])
  @@index([expiresAt])
  @@map("guestrecoverychallenge")
}

enum Notification_status {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

