  updatedAt         DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdAt])
  @@map("refund")
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
